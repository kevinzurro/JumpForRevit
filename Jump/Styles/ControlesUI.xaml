<ResourceDictionary x:Class="Jump.Styles.ControlesUI"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Jump">

    <Style x:Key="ConfigGrid" TargetType="Grid">
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="ConfigGridEtiqueta" TargetType="Grid">
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="LblTituloPrincipalInicial" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <Style x:Key="LblTituloPrincipal" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="ConfigSeparador" TargetType="Separator">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConfigStackpanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="20,5,5,5"/>
    </Style>

    <Style x:Key="ConfigToolTip" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="400"/>
    </Style>

    <Style x:Key="ConfigTextoUnidad" TargetType="TextBlock">
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ConfigTexto" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <Style x:Key="ConfigRadioButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,5"/>
    </Style>

    <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>

    <Style x:Key="ConfigComboBox" TargetType="ComboBox">
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
    </Style>

    <Style x:Key="ConfigImagenPreview" TargetType="Image">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="LblTextoBoxStackpanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="LblTextoBlock" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="LblTextoBox" TargetType="TextBox">
        <Setter Property="Margin" Value="0,5,5,0"/>
    </Style>

    <Style x:Key="BtnBotonConImagen" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <Style x:Key="BtnAceptarCancelar" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="90"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BtnImagenYTexto" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="5,0,10,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <Style x:Key="ImgImagenYTexto" TargetType="Image">
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style x:Key="TxbImagenYTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RbtnTexto" TargetType="RadioButton">
        <Setter Property="Margin" Value="5,5,5,5"/>
    </Style>

    <Style x:Key="SepDetAut" TargetType="Separator">
        <Setter Property="Margin" Value="0,0,10,5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TxbDetAut" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ChbDetAut" TargetType="CheckBox">
        <Setter Property="Margin" Value="5,5,10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CmbDetAut" TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2,10,5"/>
    </Style>

    <Style x:Key="CmbDetAutNombre" TargetType="ComboBox">
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
        <Setter Property="Margin" Value="0,2,10,5"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type local:Familia}">
                    <TextBlock Text="{Binding Nombre}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CmbDetAutNombreCompleto" TargetType="ComboBox">
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
        <Setter Property="Margin" Value="0,2,10,5"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type local:Familia}">
                    <TextBlock Text="{Binding NombreCompleto}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CmbDetAutNombreCompletoID" TargetType="ComboBox">
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
        <Setter Property="Margin" Value="0,2,10,5"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type local:Familia}">
                    <TextBlock Text="{Binding NombreCompletoID}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
