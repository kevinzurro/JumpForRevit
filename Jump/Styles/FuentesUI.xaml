<ResourceDictionary x:Class="Jump.Styles.FuentesUI"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Jump.Styles">
    
    <Style x:Key="ConfigGrid" TargetType="Grid">
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="ConfigGridEtiqueta" TargetType="Grid">
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="ConfigTituloPrincipal" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="ConfigSeparador" TargetType="Separator">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConfigStackpanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="20,5,5,5"/>
    </Style>

    <Style x:Key="ConfigToolTip" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="400"/>
    </Style>

    <Style x:Key="ConfigTextoUnidad" TargetType="TextBlock">
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ConfigTexto" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <Style x:Key="ConfigRadioButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,5"/>
    </Style>

    <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>

    <Style x:Key="ConfigComboBox" TargetType="ComboBox">
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
    </Style>

    <Style x:Key="ConfigImagenPreview" TargetType="Image">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="LblTextoBoxStackpanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="LblTextoBlock" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="LblTextoBox" TargetType="TextBox">
        <Setter Property="Margin" Value="0,5,5,0"/>
    </Style>
    
</ResourceDictionary>
