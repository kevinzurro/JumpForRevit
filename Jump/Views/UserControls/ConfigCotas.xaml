<UserControl x:Class="Jump.Views.UserControls.ConfigCotas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Jump"
             xmlns:vm="clr-namespace:Jump.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>
                <ResourceDictionary Source="/Jump;component/Languages/Language.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Grid.Column="0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <StackPanel Margin="0,0,0,10">
                        
                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                                   CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Viga.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                        <Label Content="{StaticResource Conf3-1-1}"
                               Style="{StaticResource ConfigTituloPrincipal}"
                               Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                                  IsChecked="{Binding VigaCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}"
                                       TextWrapping="Wrap"
                                       Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                                  IsChecked="{Binding VigaCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}"
                                       TextWrapping="Wrap"
                                       Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                                  IsChecked="{Binding VigaCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}"
                                       TextWrapping="Wrap"
                                       Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                                  IsChecked="{Binding VigaCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}"
                                       TextWrapping="Wrap"
                                       Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                                   CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Muro.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>
                        
                        <Label Content="{StaticResource Conf3-2-1}"
                           Style="{StaticResource ConfigTituloPrincipal}"
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding MuroCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding MuroCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding MuroCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding MuroCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                                   CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Columna.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>
                        
                        <Label Content="{StaticResource Conf3-3-1}" 
                           Style="{StaticResource ConfigTituloPrincipal}" 
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ColumnaCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding ColumnaCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding ColumnaCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding ColumnaCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel>

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Losa.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>
                        
                        <Label Content="{StaticResource Conf3-4-1}" 
                           Style="{StaticResource ConfigTituloPrincipal}" 
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding LosaCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding LosaCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding LosaCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding LosaCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Margin="0,0,20,0">

                    <StackPanel Margin="0,0,0,10">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Zapata_Aislada.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                        <Label Content="{StaticResource Conf3-5-1}"
                           Style="{StaticResource ConfigTituloPrincipal}"
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Zapata_Corrida.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                        <Label Content="{StaticResource Conf3-6-1}"
                           Style="{StaticResource ConfigTituloPrincipal}"
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCorridaCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCorridaCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCorridaCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding ZapataCorridaCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}"
                                   TextWrapping="Wrap"
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Platea.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                        <Label Content="{StaticResource Conf3-7-1}" 
                           Style="{StaticResource ConfigTituloPrincipal}" 
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}"
                              IsChecked="{Binding PlateaCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PlateaCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PlateaCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PlateaCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                    <StackPanel>

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Cotas_Pilote.png">
                                </i:InvokeCommandAction>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                        <Label Content="{StaticResource Conf3-8-1}" 
                           Style="{StaticResource ConfigTituloPrincipal}" 
                           Margin="0">
                        </Label>

                        <Separator Style="{StaticResource ConfigSeparador}"/>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PiloteCotaLinealArriba}">

                            <TextBlock Text="{StaticResource Pos10}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PiloteCotaLinealDerecha}">

                            <TextBlock Text="{StaticResource Pos11}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PiloteCotaLinealAbajo}">

                            <TextBlock Text="{StaticResource Pos12}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                        <CheckBox Style="{StaticResource ConfigCheckBox}" 
                              IsChecked="{Binding PiloteCotaLinealIzquierda}">

                            <TextBlock Text="{StaticResource Pos13}" 
                                   TextWrapping="Wrap" 
                                   Style="{Binding ConfigTexto}">
                            </TextBlock>

                        </CheckBox>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </ScrollViewer>

        <Image Style="{StaticResource ConfigImagenPreview}"
               Source="{Binding ImagenPreview}">
        </Image>

    </Grid>

</UserControl>
