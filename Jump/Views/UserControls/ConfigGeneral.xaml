<UserControl x:Class="Jump.Views.UserControls.ConfigGeneral"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Jump"
             xmlns:vm="clr-namespace:Jump.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>
        
        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                
                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>
                <ResourceDictionary Source="/Jump;component/Languages/Resource.es-ES.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
        
    </UserControl.Resources>

    <Grid>
        
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,20,0">

                <Label Content="{StaticResource Conf1-2-1}"
                   Style="{StaticResource ConfigTituloPrincipal}"
                   Margin="0">
                </Label>

                <Separator Style="{StaticResource ConfigSeparador}"/>

                <StackPanel Style="{StaticResource ConfigStackpanel}">
                    
                    <StackPanel.ToolTip>
                        
                        <ToolTip Style="{StaticResource ConfigToolTip}" 
                                 Content="{StaticResource Conf1-2-2}"/>
                        
                    </StackPanel.ToolTip>

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="MouseEnter">

                            <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Precision.png"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                    <Grid Margin="0,0,0,5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{StaticResource Conf1-2-3}"
                               Style="{Binding ConfigTexto}">
                        </TextBlock>

                        <TextBox Grid.Column="1"
                             Text="{Binding PrecisionOrdenarX}">
                        </TextBox>

                        <TextBlock Grid.Column="2"
                               Text="{Binding TxtUnidadDistancia}"
                               Style="{StaticResource ConfigTextoUnidad}">
                        </TextBlock>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{StaticResource Conf1-2-4}"
                               Style="{Binding ConfigTexto}">
                        </TextBlock>

                        <TextBox Grid.Column="1"
                             Text="{Binding PrecisionOrdenarY}">
                        </TextBox>

                        <TextBlock
                        Grid.Column="2"
                        Text="{Binding TxtUnidadDistancia}"
                        Style="{StaticResource ConfigTextoUnidad}">
                        </TextBlock>

                    </Grid>

                </StackPanel>

                <Label Content="{StaticResource Conf1-3-1}"
                   Style="{StaticResource ConfigTituloPrincipal}">
                </Label>

                <Separator Style="{StaticResource ConfigSeparador}"/>

                <StackPanel Style="{StaticResource ConfigStackpanel}">
                    
                    <StackPanel.ToolTip>
                        
                        <ToolTip Style="{StaticResource ConfigToolTip}" 
                                 Content="{StaticResource Conf1-3-2}"/>
                        
                    </StackPanel.ToolTip>

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="MouseEnter">

                            <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Viga.png"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{StaticResource Conf1-3-3}"
                               Style="{Binding ConfigTexto}">
                        </TextBlock>

                        <TextBox Grid.Column="1"
                             Text="{Binding PrecisionNodoAnalitico}">
                        </TextBox>

                        <TextBlock Grid.Column="2"
                               Text="{Binding TxtUnidadDistancia}"
                               Style="{StaticResource ConfigTextoUnidad}">
                        </TextBlock>
                    </Grid>

                </StackPanel>

                <Label Content="{StaticResource Conf1-4-1}"
                   Style="{StaticResource ConfigTituloPrincipal}">
                </Label>

                <Separator Style="{StaticResource ConfigSeparador}"/>

                <StackPanel Style="{StaticResource ConfigStackpanel}">

                    <StackPanel.ToolTip>

                        <ToolTip Style="{StaticResource ConfigToolTip}" 
                                 Content="{StaticResource Conf1-4-2}"/>

                    </StackPanel.ToolTip>

                    <RadioButton Content="{StaticResource Conf1-4-3}"
                             IsChecked="{Binding VistaLocal}"
                             Style="{StaticResource ConfigRadioButton}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                                   CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Vista_Local.png"/>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </RadioButton>

                    <RadioButton Content="{StaticResource Conf1-4-4}"
                             IsChecked="{Binding VistaGlobal}"
                             Style="{StaticResource ConfigRadioButton}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseEnter">

                                <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                                   CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Vista_Global.png"/>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </RadioButton>

                </StackPanel>

                <Label Content="{StaticResource Conf1-5-1}"
                   Style="{StaticResource ConfigTituloPrincipal}">
                </Label>

                <Separator Style="{StaticResource ConfigSeparador}"/>

                <StackPanel Style="{StaticResource ConfigStackpanel}">

                    <StackPanel.ToolTip>

                        <ToolTip Style="{StaticResource ConfigToolTip}" 
                                 Content="{StaticResource Conf1-5-2}"/>

                    </StackPanel.ToolTip>

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="MouseEnter">

                            <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_Seccion_Transversal.png"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{StaticResource Conf1-5-3}"
                               Style="{Binding ConfigTexto}">
                        </TextBlock>

                        <TextBox Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Text="{Binding CorteTransversal}">
                        </TextBox>

                        <TextBlock Grid.Column="2"
                               Text="{StaticResource Conf1-5-4}"
                               Style="{StaticResource ConfigTextoUnidad}">
                        </TextBlock>

                    </Grid>

                </StackPanel>

                <Label Content="{StaticResource Conf1-6-1}"
                   Style="{StaticResource ConfigTituloPrincipal}">
                </Label>

                <Separator Style="{StaticResource ConfigSeparador}"/>

                <StackPanel Style="{StaticResource ConfigStackpanel}">

                    <StackPanel.ToolTip>

                        <ToolTip Style="{StaticResource ConfigToolTip}" 
                                 Content="{StaticResource Conf1-6-2}"/>

                    </StackPanel.ToolTip>

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="MouseEnter">

                            <i:InvokeCommandAction Command="{Binding CambiarImagenCommand}"
                                               CommandParameter="pack://application:,,,/Jump;component/Resources/Configuracion_TextoAbajo.png"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="{StaticResource Conf1-6-3}"
                               Style="{Binding ConfigTexto}">
                        </TextBlock>

                        <TextBox Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Text="{Binding PuntoAEvaluarOrden}">
                        </TextBox>

                        <TextBlock Grid.Column="2"
                               Text="{StaticResource Conf1-6-4}"
                               Style="{StaticResource ConfigTextoUnidad}">
                        </TextBlock>

                    </Grid>

                </StackPanel>

            </StackPanel>
            
        </ScrollViewer>


        <Image Grid.Column="1"
            Stretch="Uniform"
            Source="{Binding ImagenPreview}">
        </Image>

    </Grid>
    
</UserControl>
