<Window x:Class="Jump.Views.WinConfiguraciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Jump"
        xmlns:vm="clr-namespace:Jump.ViewModels"
        xmlns:control="clr-namespace:Jump.Views.Controls"
        xmlns:userControl="clr-namespace:Jump.Views.UserControls"
        mc:Ignorable="d"
        MinHeight="500" MinWidth="700" WindowStartupLocation="CenterScreen"
        Height="500" Width="700"
        Title="Configuraciones">

    <Window.Resources>
        
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:ConfigGeneralViewModel}">
            
                <userControl:ConfigGeneral DataContext="{Binding}"/>
            
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ConfigEtiquetasViewModel}">
            
                <userControl:ConfigEtiquetas DataContext="{Binding}"/>
            
            </DataTemplate>
        
        </ResourceDictionary>

    </Window.Resources>

    <Grid Style="{StaticResource ConfigGrid}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>            
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">

            <control:BtnImagenTexto Title="General"
                                    Image="/Jump;component/Resources/Boton_Config_General.png"/>

            <control:BtnImagenTexto Title="Etiquetas"
                                    Image="/Jump;component/Resources/Boton_Config_Etiquetas.png"/>

            <control:BtnImagenTexto Title="Cotas"
                                    Image="/Jump;component/Resources/Boton_Config_Cota.png"/>

        </StackPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding}">
            
        </ContentControl>
        
    </Grid>
    
</Window>
