<Window x:Class="Jump.Views.WinCrearPlanos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Jump"
        xmlns:res="clr-namespace:Jump.Properties.Languages"
        mc:Ignorable="d"
        MinHeight="450" MinWidth="650" WindowStartupLocation="CenterScreen"
        Height="450" Width="650"
        Title="Crear planos">
    
    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>

        </Grid.RowDefinitions>

        <DockPanel Margin="5">

            <Label DockPanel.Dock="Top"
                   Name="lblVistas"
                   Content = "Vistas">
            </Label>

            <TreeView x:Name="trvVistas"
                      Grid.Column="0"
                      Grid.Row="0"
                      Height="auto"
                      Width="auto"
                      ItemsSource="{Binding VistasParaMostrar}">
                
                <TreeView.ItemContainerStyle>
                    
                    <Style TargetType="TreeViewItem">
                        
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        
                    </Style>
                    
                </TreeView.ItemContainerStyle>
                
                <TreeView.ItemTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type local:MenuItem}"
                                              ItemsSource="{Binding Items}">

                        <StackPanel Orientation="Horizontal">

                            <CheckBox IsThreeState="False"
                                      IsChecked="{Binding IsChecked}"
                                      Command="{Binding CambiarCheckedCommand}"/>

                            <TextBlock Text="{Binding Nombre}"/>
                            
                        </StackPanel>
                        
                    </HierarchicalDataTemplate>
                    
                </TreeView.ItemTemplate>
                
            </TreeView>

        </DockPanel>

        <DockPanel Margin="5"
                   Grid.Column="1">

            <Label DockPanel.Dock="Top"
                   Name="lblPlanos"
                   Content="Tipo de plano">
            </Label>

            <ListBox x:Name="lstTipoPlano"
                     Height="auto"
                     Width="auto"
                     ItemsSource="{Binding Planos}"
                     SelectedItem="{Binding TipoPlano}">
                
                <ListBox.ItemTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type local:Familia}">
                        
                        <TextBlock Text="{Binding NombreCompleto}"/>
                        
                    </HierarchicalDataTemplate>
                    
                </ListBox.ItemTemplate>
                
            </ListBox>

        </DockPanel>

        <StackPanel Grid.Column="0" Grid.Row="1">

            <CheckBox Grid.Column="0"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="5"
                  Content="Crear un plano por cada vista"
                  IsChecked="{Binding UnPlanoPorVista}">
            </CheckBox>

        </StackPanel>

        <Grid Grid.Row="2"
              Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="0.66*"/>
                <ColumnDefinition Width="0.34*"/>

            </Grid.ColumnDefinitions>

            <Button x:Name="btnAceptar"
                    Content="Aceptar" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,105,0"
                    Width="90"
                    Height="30"
                    Grid.Column="1"
                    Command="{Binding CrearPlanosCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            </Button>

            <Button x:Name="btnCancelar"
                    Content="Cancelar" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Margin="5"
                    Width="90"
                    Height="30"
                    Grid.Column="1" 
                    IsCancel="True">
            </Button>

            <DockPanel Grid.Row="0" Margin="5,0">

                <Button x:Name="btnSeleccionarTodos"
                    Content="Todos" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Margin="0,5,5,5"
                    Width="90"
                    Height="30" 
                    Command="{Binding TodosCommand}">
                </Button>

                <Button x:Name="btnSeleccionarNinguno"
                    Content="Ninguno" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Margin="5"
                    Width="90"
                    Height="30" 
                    Command="{Binding NingunoCommand}">
                </Button>

                <Button x:Name="btnExpandir"
                    Content="Expandir" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Margin="5"
                    Width="90"
                    Height="30"
                    Command="{Binding ExpandirCommand}">
                </Button>

                <Button x:Name="btnContraer"
                    Content="Contraer" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Margin="5"
                    Width="90"
                    Height="30"
                    Command="{Binding ContraerCommand}">
                </Button>

            </DockPanel>

        </Grid>

    </Grid>
</Window>
