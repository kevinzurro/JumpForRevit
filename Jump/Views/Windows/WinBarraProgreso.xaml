<Window x:Class="Jump.Views.Windows.WinBarraProgreso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Jump"
        mc:Ignorable="d" 
        MinHeight="150" MinWidth="650" 
        WindowStartupLocation="CenterScreen"
        Height="150" Width="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>
                <ResourceDictionary Source="/Jump;component/Languages/Language.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="auto"/>
            
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="5"
                   x:Name="txtTexto"
                   Text="{Binding Texto}">
        </TextBlock>

        <ProgressBar Grid.Row="1"
                     x:Name="pbrBarra"
                     Margin="5,10"
                     Minimum="0">
        </ProgressBar>

        <Button Grid.Row="2"
                x:Name="btnCancelar"
                IsCancel="True"
                Style="{StaticResource BtnAceptarCancelar}"
                Content="{StaticResource BarPro3}"
                Click="btnCancelar_Click">
        </Button>
        
    </Grid>
    
</Window>
