<Window x:Class="Jump.Views.Windows.WinDetalleAutomatico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Jump"
        xmlns:vm="clr-namespace:Jump.ViewModels"
        xmlns:userControl="clr-namespace:Jump.Views.UserControls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1000" 
        Height="600" Width="1000">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>
                <ResourceDictionary Source="/Jump;component/Languages/Language.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DetAutUserControlViewModelXX}">

                <userControl:DetAutSeccion DataContext="{Binding}"/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DetAutUserControlViewModelYY}">

                <userControl:DetAutSeccion DataContext="{Binding}"/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DetAutUserControlViewModelPlanta}">

                <userControl:DetAutSeccion DataContext="{Binding}"/>

            </DataTemplate>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        </ResourceDictionary>

    </Window.Resources>

    <Grid Style="{StaticResource ConfigGrid}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">

            <Label Style="{StaticResource LblTituloPrincipalInicial}"
                   Content="{StaticResource DetAut10}">
            </Label>

            <Separator Style="{StaticResource SepDetAut}"/>

            <Button Style="{StaticResource BtnImagenYTexto}"
                    Command="{Binding SeccionXXCommand}">

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left">

                    <CheckBox Style="{StaticResource ChbDetAut}"
                              IsChecked="{Binding VistaXX}">
                    </CheckBox>
                    
                    <Image Style="{StaticResource ImgImagenYTexto}"
                           Source="/Jump;component/Resources/Boton_Config_General.png">
                    </Image>

                    <TextBlock Style="{StaticResource TxbImagenYTexto}"
                               Text="{StaticResource DetAutXX}">
                    </TextBlock>

                </StackPanel>

            </Button>

            <Button Style="{StaticResource BtnImagenYTexto}"
                    Command="{Binding SeccionYYCommand}">

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left">

                    <CheckBox Style="{StaticResource ChbDetAut}"
                              IsChecked="{Binding VistaYY}">
                    </CheckBox>
                    
                    <Image Style="{StaticResource ImgImagenYTexto}"
                           Source="/Jump;component/Resources/Boton_Config_General.png">
                    </Image>

                    <TextBlock Style="{StaticResource TxbImagenYTexto}"
                               Text="{StaticResource DetAutYY}">
                    </TextBlock>

                </StackPanel>

            </Button>

            <Button Style="{StaticResource BtnImagenYTexto}"
                    Command="{Binding PlanoEstructuralCommand}">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    
                    <CheckBox Style="{StaticResource ChbDetAut}"
                              IsChecked="{Binding VistaPlanta}">
                    </CheckBox>

                    <Image Style="{StaticResource ImgImagenYTexto}"
                           Source="/Jump;component/Resources/Boton_Config_General.png">
                    </Image>

                    <TextBlock Style="{StaticResource TxbImagenYTexto}"
                               Text="{StaticResource DetAutPlaEst}">
                    </TextBlock>

                </StackPanel>

            </Button>

        </StackPanel>

        <ContentControl Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Content="{Binding VistaActual}">
        </ContentControl>

        <Button Content="{StaticResource DetAut5}"
                Style="{StaticResource BtnAceptarCancelar}"
                Margin="0,0,105,0"
                Grid.Column="1"
                Grid.Row="2"
                Command="{Binding AceptarCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
        </Button>

        <Button Content="{StaticResource DetAut6}"
                Style="{StaticResource BtnAceptarCancelar}"
                Margin="5"
                Grid.Column="1"
                Grid.Row="2"
                IsCancel="True">
        </Button>

    </Grid>
    
</Window>
