<Window x:Class="Jump.Views.Windows.WinEnumeracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Jump"
        xmlns:lang="clr-namespace:Jump.Languages"
        xmlns:vm="clr-namespace:Jump.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:Controls="clr-namespace:Jump.Views.Controls"
        mc:Ignorable="d"
        MinHeight="600" MinWidth="800"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Jump;component/Styles/Estilos.xaml"/>
                <ResourceDictionary Source="/Jump;component/Languages/Language.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*"
                           MinHeight="80"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="3*"
                           MinHeight="100"/>
            <RowDefinition Height="40"/>

        </Grid.RowDefinitions>

        <TextBlock Margin="10,0"
                   FontWeight="Bold"
                   Text="{StaticResource OrdYEnu1-1}"/>

        <TextBlock Grid.Column="1"
                   FontWeight="Bold"
                   Margin="10,0"
                   Text="{StaticResource OrdYEnu3-7}"/>

        <TextBlock Grid.Column="2"
                   FontWeight="Bold"
                   Margin="5,0"
                   Text="{StaticResource OrdYEnu3-8}"/>

        <ListBox Grid.Row="1"
                 Margin="5"
                 ItemsSource="{Binding Categorias}"
                 SelectedItem="{Binding CategoriaSeleccionada}"
                 DisplayMemberPath="Nombre">

            <i:Interaction.Triggers>

                <i:EventTrigger EventName="PreviewKeyDown">

                    <i:InvokeCommandAction Command="{Binding TeclaCommand}"
                                           PassEventArgsToCommand="True"/>

                </i:EventTrigger>

            </i:Interaction.Triggers>

        </ListBox>

        <ListBox Grid.Column="1" 
                 Grid.Row="1"
                 Margin="5"
                 ItemsSource="{Binding Parametros}"
                 SelectedItem="{Binding ParametroSeleccionada}"
                 DisplayMemberPath="Nombre"/>

        <Grid Grid.Column="2"
              Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <StackPanel Style="{StaticResource LblTextoBoxStackpanel}">

                <TextBlock Style="{StaticResource LblTextoBlock}"
                           Text="{StaticResource OrdYEnu3-2}">
                </TextBlock>

                <TextBlock Style="{StaticResource LblTextoBlock}"
                           Text="{StaticResource OrdYEnu3-3}">
                </TextBlock>

                <TextBlock Style="{StaticResource LblTextoBlock}"
                           Text="{StaticResource OrdYEnu3-4}">
                </TextBlock>

                <TextBlock Style="{StaticResource LblTextoBlock}"
                           Text="{StaticResource OrdYEnu3-5}">
                </TextBlock>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Style="{StaticResource LblTextoBoxStackpanel}">

                <TextBox Style="{StaticResource LblTextoBox}"
                         Text="{Binding Prefijo}">
                </TextBox>

                <TextBox Style="{StaticResource LblTextoBox}"
                         Text="{Binding Inicial}">
                </TextBox>

                <TextBox Style="{StaticResource LblTextoBox}"
                         Text="{Binding Incremento}">
                </TextBox>

                <TextBox Style="{StaticResource LblTextoBox}"
                         Text="{Binding Sufijo}">
                </TextBox>

            </StackPanel>

        </Grid>

        <GridSplitter Grid.Row="2"
                      Grid.ColumnSpan="3"
                      Margin="5,0"
                      BorderThickness="2"
                      HorizontalAlignment="Stretch">
        </GridSplitter>

        <DataGrid Grid.ColumnSpan="3"
                  Grid.Row="3"
                  Margin="5"
                  ItemsSource="{Binding Elementos}">
        </DataGrid>

        <Button Content="{StaticResource OrdYEnu5}"
                Style="{StaticResource BtnAceptarCancelar}"
                Margin="0,0,105,0"
                Grid.Column="2"
                Grid.Row="5"
                Command="{Binding AceptarCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        </Button>

        <Button Content="{StaticResource OrdYEnu6}"
                Style="{StaticResource BtnAceptarCancelar}"
                Margin="5"
                Grid.Column="2"
                Grid.Row="5"
                IsCancel="True">
        </Button>

    </Grid>

</Window>
